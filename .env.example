# Copy this file to .env.local and fill in your Supabase project values.
# Both are PUBLIC client values — never put the service_role key here.
# Find them in Supabase: Project Settings -> API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: Google Drive backup (per-user, opt-in). PUBLIC OAuth Client ID only
# — never a client secret. Create an OAuth 2.0 Client ID (type: Web application)
# in Google Cloud Console, enable the Drive API, and add your app origin to the
# Authorized JavaScript origins. The app requests ONLY the drive.file scope.
# If unset, the Drive feature is hidden and nothing changes.
VITE_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
